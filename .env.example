# Copy to .env and fill in. .env is gitignored and must never be committed.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Database (required) ---
# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=
# Neon DIRECT connection string (no "-pooler"). Used only by migrations.
# Not in the build prompt's section 11 list — added because pooled connections
# cannot run schema migrations. See README assumptions.
DATABASE_URL_UNPOOLED=

# --- Access (required) ---
# Raghav: upload, on-order, review, export, confirm send.
REVIEWER_PASSCODE=
# Deepa: settings, backup checker, pause decisions, RCA verdicts.
ADMIN_PASSCODE=
# Signs the session cookie. Random 32 bytes, not a word.
SESSION_SECRET=

# --- Scheduling (required) ---
# Vercel sends this as "Authorization: Bearer <value>" on every cron call.
CRON_SECRET=
# All dates, ISO weeks and months are computed in this zone.
APP_TIMEZONE=Asia/Kolkata

# --- AI (optional, default off) ---
# When false, exception reasons are generated by plain code. The app works fully without a key.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=claude-haiku-5-5

# --- Email (optional, default off) ---
# When false, the missed-upload reminder is an in-app banner only.
EMAIL_ENABLED=false
EMAIL_API_KEY=
EMAIL_FROM=
RAGHAV_EMAIL=
DEEPA_EMAIL=
MAX_EMAILS_PER_DAY=20
